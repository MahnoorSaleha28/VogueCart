<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shop Jewellery, Accessories, Hair, Beauty & More | Claire's</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" type="text/css" href="css/style.css">
  </head>
  <body>      
    <!-- Sale Tag Section -->
     <div class="white-space"></div>
    <div class="container my-4 sale-banner">
      <div class="row sale-banner">
        <div class="col-12 col-md-6">
          <div class="text-center">
            <p class="text-white pt-4 fs-4">LAST CHANCE!</p>
            <p class="sale-text">SALE</p>
            <p class="text-white">Exclusions apply</p>
          </div>
        </div>
        <div class="col-12 col-md-6 py-4">
          <div class="text-center">
            <p class="text-white pt-4 fs-5 fw-bold">IN-STORE & ONLINE</p>
            <p class="text-white fs-4 fw-bold">End of Season Sale</p>
            <p class="text-white fs-4 fw-bold"></p>
            <div>
              <a href="/toys" class="btn mt-3 btn-custom1">SHOP NOW</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Best Seller Products -->
    <div class="container mt-5">
      <h2 class="mb-4 text-center">Best Sellers</h2>
      <div class="row justify-content-center">
        <% bestSellers.forEach(product => { %>
          <div class="col-6 col-md-3 mb-4">
            <div class="product-card">
              <div class="product-image-container">
                <img
                  class="prod-img img-fluid"
                  src="<%= product.image %>"
                  alt="<%= product.name %>"
                />
              </div>
              <div class="product-info">
                <h5 class="product-name"><%= product.name %></h5>
                <p class="product-price"><strong>Rs.<%= product.price %></strong></p>
                <form action="/cart/add" method="POST">
                  <input type="hidden" name="productId" value="<%= product.id %>">
                  <button type="submit" class="btn btn-custom">ADD TO BAG</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="main-container">
      <% if (categoryProducts && categoryProducts.length > 0) { %>
        <% categoryProducts.forEach(category => { %>
          <!-- Category Section -->
          <div class="container mt-5">
            <h2 class="mb-4 text-center"> <!-- Centered Category Title, links to the category page -->
              <a class="category-link" href="/<%= category.category.toLowerCase() %>">
                <%= category.category %> <i class="fa-solid fa-chevron-right"></i>
              </a>
            </h2>
            <div class="row justify-content-center">
              <% category.products.forEach(product => { %>
                <div class="col-6 col-md-3 mb-4">
                  <div class="product-card">
                    <div class="product-image-container">
                      <img
                        class="prod-img img-fluid"
                        src="<%= product.image %>"
                        alt="<%= product.name %>"
                      />
                    </div>
                    <div class="product-info">
                      <h5 class="product-name"><%= product.name %></h5>
                      <p class="product-price">
                        <% if (product.originalPrice) { %>
                          <del>Rs.<%= product.originalPrice %></del>
                        <% } %>
                        <strong>Rs.<%= product.price %></strong>
                      </p>
                      <form action="/cart/add" method="POST">
                        <input type="hidden" name="productId" value="<%= product.id %>">
                        <button type="submit" class="btn btn-custom">ADD TO BAG</button>
                    </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
            <div class="text-center">
              <a href="/<%= category.category.toLowerCase() %>" class="btn btn-custom1 view-all-btn">
                VIEW ALL <%= category.category.toUpperCase() %>
              </a>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>No products found in the specified categories.</p>
      <% } %>
    </div>
    
  <!--Brands Heading-->
    <div class="container mt-5">
      <div class="best-seller-title">
        <span class="collab-icon"><i class="fa-solid fa-arrow-right"></i></span>
        <h3 class="fw-bold mb-0">New Collaborations</h3>
        <a href="/toys" class="shop-all fw-bold">SHOP ALL</a>
      </div>
    </div>

    <!-- Brands Section -->
    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-6 col-md-4 col-lg-2 mb-4">
          <a class="brand-tile" href="/search?search=Hello%20Kitty%20Soft%20Toy">
            <img class="brands-imgs" src="/images/1733776464991.webp" alt="Hello Kitty" />
            <span>Hello Kitty</span>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2 mb-4">
          <a class="brand-tile" href="/search?search=Squishmallows">
            <img class="brands-imgs" src="/images/1733776784577.jpg" alt="Squishmallows" />
            <span>Squishmallows</span>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2 mb-4">
          <a class="brand-tile" href="/search?search=Pusheen%20Pink%20Satchel%20Bag">
            <img class="brands-imgs" src="/images/1733815325235.jpg" alt="Pusheen" />
            <span>Pusheen</span>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2 mb-4">
          <a class="brand-tile" href="/search?search=Disney%20Stitch%20Soft%20Toy">
            <img class="brands-imgs" src="/images/1733777982465.jpg" alt="Disney Stitch" />
            <span>Disney Stitch</span>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2 mb-4">
          <a class="brand-tile" href="/search?search=Disney%20Princess%20Shoulder%20Bag">
            <img class="brands-imgs" src="/images/1733760641021.webp" alt="Disney Princess" />
            <span>Disney Princess</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Gallery Images Section -->
    <section>
      <div class="container">
        <div class="row">
          <div class="col-6 col-md-3 mb-4">
            <img
              src="https://edge.curalate.com/v1/img/zMzsUMIzJ-Mn2kmcYsD0J2y4768CU09oQMSXT3iIUq4=/sc/450x450?typ=webp"
              alt="Image1"
              class="img-fluid"
            />
          </div>
          <div class="col-6 col-md-3 mb-4">
            <img
              src="https://edge.curalate.com/v1/img/H9rbFB0wHJnfJdclTp4Gdp_MILn1vIvHctMaW-Qi_7A=/sc/450x450?typ=webp"
              alt="Image2"
              class="img-fluid"
            />
          </div>
          <div class="col-6 col-md-3 mb-4">
            <img
              src="https://edge.curalate.com/v1/img/zKx50oUarvycgRU7C0hNo2BvpKNcyV2-C51T0v7oKOE=/sc/450x450?typ=webp"
              alt="Image3"
              class="img-fluid"
            />
          </div>
          <div class="col-6 col-md-3 mb-4">
            <img
              src="https://edge.curalate.com/v1/img/QYSw3a0ypxPrAvVRKPlIwf__jRmpREsDBOK_7ZeoMbE=/sc/450x450?typ=webp"
              alt="Image4"
              class="img-fluid"
            />
          </div>
        </div>
      </div>
      </section>

    <!-- Bootstrap JS Link -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
