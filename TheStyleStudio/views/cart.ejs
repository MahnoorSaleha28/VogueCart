<title>Your Bag | The Style Studio</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/shop.css">

<div class="shop-page">
  <nav aria-label="breadcrumb" class="mt-2">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">Bag</li>
    </ol>
  </nav>

  <h2 class="shop-title">Your Bag</h2>

  <% if (products.length === 0) { %>
    <div class="shop-card empty-state mt-4">
      <div class="empty-state-icon"><i class="fa-solid fa-bag-shopping"></i></div>
      <h3 class="fw-semibold">Your bag is empty</h3>
      <p class="text-muted mb-4">Looks like you haven't added anything yet.</p>
      <a href="/" class="btn-shop">Start shopping</a>
    </div>
  <% } else { %>
    <p class="shop-subtitle"><%= cartCount %> <%= cartCount === 1 ? 'item' : 'items' %></p>

    <div class="row g-4">
      <!-- Cart items -->
      <div class="col-lg-8">
        <div class="shop-card">
          <% products.forEach(product => { %>
            <div class="cart-item">
              <a href="/productDetail/<%= product._id %>">
                <img class="cart-item-img" src="<%= product.image %>" alt="<%= product.name %>">
              </a>

              <div>
                <a class="cart-item-name" href="/productDetail/<%= product._id %>"><%= product.name %></a>
                <div class="cart-item-price">Rs.<%= product.price %> each</div>

                <!-- Quantity stepper: minus at 1 removes the item -->
                <div class="qty-stepper">
                  <form action="/cart/update/<%= product._id %>" method="POST">
                    <button type="submit" name="quantity" value="<%= product.quantity - 1 %>" aria-label="Decrease quantity">&minus;</button>
                  </form>
                  <span><%= product.quantity %></span>
                  <form action="/cart/update/<%= product._id %>" method="POST">
                    <button type="submit" name="quantity" value="<%= product.quantity + 1 %>" aria-label="Increase quantity">+</button>
                  </form>
                </div>
              </div>

              <div class="cart-item-side">
                <div class="cart-item-subtotal">Rs.<%= product.price * product.quantity %></div>
                <form action="/cart/remove/<%= product._id %>" method="POST">
                  <button type="submit" class="cart-remove"><i class="fa-regular fa-trash-can me-1"></i>Remove</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Order summary -->
      <div class="col-lg-4">
        <div class="shop-card summary-card">
          <h3 class="shop-card-title">Order Summary</h3>
          <div class="summary-row">
            <span>Subtotal (<%= cartCount %> <%= cartCount === 1 ? 'item' : 'items' %>)</span>
            <span>Rs.<%= totalPrice %></span>
          </div>
          <div class="summary-total">
            <span>Total</span>
            <span>Rs.<%= totalPrice %></span>
          </div>
          <a href="/checkout" class="btn-shop w-100">Proceed to checkout</a>
          <div class="text-center mt-3">
            <a href="/" class="shop-link">Continue shopping</a>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
