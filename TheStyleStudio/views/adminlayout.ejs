<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %>Admin | The Style Studio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <%-defineContent("styles-area") %>
</head>
<body class="admin-body">
    <%
      const navItems = [
        { href: '/admin/dashboard', icon: 'fa-gauge', label: 'Dashboard' },
        { href: '/admin/products', icon: 'fa-shirt', label: 'Products' },
        { href: '/admin/categories', icon: 'fa-layer-group', label: 'Categories' },
        { href: '/admin/orders', icon: 'fa-receipt', label: 'Orders' },
        { href: '/admin/user', icon: 'fa-users', label: 'Users' },
      ];
      const path = typeof currentPath !== 'undefined' ? currentPath : '';
    %>

    <!-- Sidebar: fixed on large screens, slide-out menu on small ones -->
    <aside class="offcanvas-lg offcanvas-start admin-sidebar" tabindex="-1" id="adminSidebar" aria-label="Admin menu">
        <div class="offcanvas-header d-lg-none">
            <span class="fw-semibold">Menu</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <a class="admin-brand" href="/admin/dashboard"><img src="/images/logo.png" alt="The Style Studio"></a>
            <span class="admin-brand-label">Admin Panel</span>

            <ul class="admin-nav">
                <% navItems.forEach(item => { %>
                    <li>
                        <a href="<%= item.href %>" class="<%= path.startsWith(item.href) ? 'active' : '' %>">
                            <i class="fa-solid <%= item.icon %>"></i><%= item.label %>
                        </a>
                    </li>
                <% }) %>
            </ul>

            <ul class="admin-nav admin-nav-bottom">
                <li><a href="/" target="_blank"><i class="fa-solid fa-store"></i>View Store</a></li>
                <li>
                    <form action="/admin/logout" method="POST">
                        <button type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i>Log Out</button>
                    </form>
                </li>
            </ul>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <button class="admin-menu-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Open menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <h1><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin' %></h1>
            <% if (typeof admin !== 'undefined' && admin) { %>
                <div class="admin-user">
                    <% if (admin.role === 'demo') { %><span class="admin-badge warning">Demo</span><% } %>
                    <span><%= admin.email %></span>
                    <span class="admin-avatar"><%= admin.email.charAt(0) %></span>
                </div>
            <% } %>
        </header>

        <main class="admin-content">
            <% if (typeof admin !== 'undefined' && admin && admin.role === 'demo') { %>
                <div class="admin-flash demo" role="note">
                    <i class="fa-solid fa-eye"></i>
                    <span><strong>Read-only demo.</strong> Look around freely. Changes aren't saved, and customer details are hidden.</span>
                </div>
            <% } %>
            <% if (successMessage) { %>
                <div class="admin-flash success" role="status">
                    <i class="fa-solid fa-circle-check"></i><span><%= successMessage %></span>
                    <button type="button" class="btn-close" aria-label="Close" onclick="this.parentElement.remove()"></button>
                </div>
            <% } %>
            <% if (errorMessage) { %>
                <div class="admin-flash error" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i><span><%= errorMessage %></span>
                    <button type="button" class="btn-close" aria-label="Close" onclick="this.parentElement.remove()"></button>
                </div>
            <% } %>

            <%-body  %>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
      // Ask before any delete form is submitted
      document.querySelectorAll('form[data-confirm]').forEach(form => {
        form.addEventListener('submit', event => {
          if (!confirm(form.dataset.confirm)) event.preventDefault();
        });
      });
    </script>
    <%-defineContent("footer-area") %>
</body>
</html>
