<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg bg-light text-uppercase fs-6 p-3 border-bottom align-items-center sticky-top">
  <div class="container-fluid">
      <div class="row justify-content-between align-items-center w-100">
        <div class="col-auto">
          <a class="navbar-brand text-white" href="/">
            <img src="../images/logo.png" style="width: 200px;">
          </a>
        </div>
  
        <div class="col-auto d-flex align-items-center">
          <button type="button" class="nav-search-toggle d-lg-none me-2" aria-label="Search" aria-controls="siteSearch" aria-expanded="false">
            <i class="fa-solid fa-magnifying-glass fa-lg"></i>
          </button>
          <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>
  
          <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
            <div class="offcanvas-header">
              <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Menu</h5>
              <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
  
            <div class="offcanvas-body">
              <ul class="navbar-nav justify-content-end flex-grow-1 gap-1 gap-lg-2 gap-xxl-4 pe-3">
                <%
                  // Highlight the category being viewed: its own page, or a product from it
                  const navPath = typeof currentPath !== "undefined" ? currentPath : "";
                  const navProductCategory = typeof product !== "undefined" && product && product.category && product.category.name
                    ? product.category.name.toLowerCase() : "";
                  const navCategories = ["Clothes", "Jewellery", "Bags", "Toys", "Accessories"];
                %>
                <% navCategories.forEach(name => { %>
                  <% const slug = name.toLowerCase(); %>
                  <% const isActive = navPath.startsWith("/" + slug) || navProductCategory === slug; %>
                  <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle <%= isActive ? "active" : "" %>" href="/<%= slug %>" id="dropdown-<%= slug %>" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" <%- isActive ? 'aria-current="page"' : "" %>><%= name %></a>
                    <ul class="dropdown-menu list-unstyled" aria-labelledby="dropdown-<%= slug %>">
                      <li>
                        <a href="/<%= slug %>" class="dropdown-item item-anchor">View All</a>
                      </li>
                    </ul>
                  </li>
                <% }) %>
                <li class="nav-item">
                  <a class="nav-link" href="/admin/login">Admin Panel</a>
                </li>
                <li class="nav-item d-none d-lg-block">
                  <button type="button" class="nav-link nav-search-toggle" aria-label="Search" aria-controls="siteSearch" aria-expanded="false">
                    <i class="fa-solid fa-magnifying-glass fa-lg"></i>
                  </button>
                </li>
                <li class="nav-item position-relative">
                  <a href="/cart" class="nav-link text-dark">
                      <i class="fa-solid fa-cart-shopping px-2 fa-lg"></i>
                      <% if (cartCount > 0) { %>
                          <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark">
                              <%= cartCount %>
                          </span>
                      <% } %>
                  </a>
              </li>
              <li class="nav-item position-relative">
                <a href="/login" class="nav-link text-dark">
                  <!-- User Icon -->
                  <i class="fas fa-user fa-3x fa-lg" style="font-size: large; cursor: pointer" id="userIcon"></i> 
                  <!-- <a href="/Authentication/logout" class="btn btn-success btn-sm me-3">Logout</a> -->
                </a>
              </li>
              </ul>
            </div>
          </div>
        </div>
  
     
    
      </div>
  </div>
  <%
    // Stays open with the search filled in on the results page
    const searchQuery = typeof query !== "undefined" && typeof currentPath !== "undefined" && currentPath === "/search" ? query : "";
  %>
  <div class="site-search w-100" id="siteSearch" <%= searchQuery ? "" : "hidden" %>>
    <form action="/search" method="GET" class="site-search-form" role="search">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="search" name="search" id="siteSearchInput" value="<%= searchQuery %>" placeholder="Search products, e.g. backpack, earrings, Disney" aria-label="Search products" autocomplete="off" required>
      <button type="submit" class="site-search-submit">Search</button>
      <button type="button" class="site-search-close" aria-label="Close search">&times;</button>
    </form>
  </div>
</nav>

<script>
  (function () {
    var bar = document.getElementById("siteSearch");
    var input = document.getElementById("siteSearchInput");
    var toggles = document.querySelectorAll(".nav-search-toggle");
    function setOpen(open) {
      bar.hidden = !open;
      toggles.forEach(function (t) { t.setAttribute("aria-expanded", open); });
      if (open) input.focus();
    }
    toggles.forEach(function (t) {
      t.addEventListener("click", function () { setOpen(bar.hidden); });
    });
    bar.querySelector(".site-search-close").addEventListener("click", function () { setOpen(false); });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !bar.hidden) setOpen(false);
    });
  })();
</script>

<% if (typeof cartMessage !== 'undefined' && cartMessage) { %>
<!-- "Added to your bag" toast -->
<div class="cart-toast" id="cartToast" role="status">
  <i class="fa-solid fa-circle-check"></i>
  <span><%= cartMessage %></span>
  <a href="/cart">VIEW BAG</a>
  <button type="button" class="cart-toast-close" aria-label="Close" onclick="this.parentElement.remove()">&times;</button>
</div>
<script>
  setTimeout(function () {
    var toast = document.getElementById("cartToast");
    if (toast) toast.classList.add("cart-toast-hide");
  }, 4000);
</script>
<% } %>
