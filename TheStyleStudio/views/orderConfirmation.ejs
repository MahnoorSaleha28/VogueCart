<title>Order Confirmed | The Style Studio</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/shop.css">

<div class="shop-page">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="text-center mt-4">
        <div class="confirm-icon"><i class="fa-solid fa-check"></i></div>
        <h2 class="shop-title">Thank you, <%= order.name %>!</h2>
        <p class="shop-subtitle mb-3">Your order has been placed.</p>
        <div class="order-meta">
          <span>Order <strong>#<%= order._id.toString().slice(-6).toUpperCase() %></strong></span>
          <span>Placed <strong><%= order.createdAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></strong></span>
        </div>
      </div>

      <div class="shop-card mb-4">
        <h3 class="shop-card-title">Order Details</h3>
        <% items.forEach(item => { %>
          <div class="summary-item">
            <img src="<%= item.productId.image %>" alt="<%= item.productId.name %>">
            <div class="summary-item-name">
              <%= item.productId.name %>
              <small>Qty <%= item.quantity %></small>
            </div>
            <div class="summary-item-price">Rs.<%= item.productId.price * item.quantity %></div>
          </div>
        <% }) %>
        <div class="summary-total mb-0">
          <span>Total</span>
          <span>Rs.<%= order.totalPrice %></span>
        </div>
      </div>

      <div class="shop-card mb-4 delivery-details">
        <h3 class="shop-card-title">Delivering To</h3>
        <p><i class="fa-solid fa-user"></i><%= order.name %></p>
        <p><i class="fa-solid fa-location-dot"></i><%= order.address %></p>
        <p class="mb-0"><i class="fa-solid fa-phone"></i><%= order.phone %></p>
      </div>

      <div class="shop-card mb-4 delivery-details">
        <h3 class="shop-card-title">Payment</h3>
        <p class="d-flex flex-wrap align-items-center gap-2 mb-0">
          <i class="fa-solid <%= order.paymentMethod === 'card' ? 'fa-credit-card' : order.paymentMethod === 'wallet' ? 'fa-mobile-screen-button' : 'fa-money-bill-wave' %>"></i>
          <span class="me-auto"><%= order.paymentDetails || 'Cash on delivery' %></span>
          <span class="payment-status <%= order.paymentStatus === 'Paid' ? 'paid' : '' %>">
            <%= order.paymentStatus === 'Paid' ? 'Paid' : 'Pay Rs.' + order.totalPrice + ' on delivery' %>
          </span>
        </p>
      </div>

      <div class="text-center">
        <a href="/" class="btn-shop">Continue shopping</a>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
