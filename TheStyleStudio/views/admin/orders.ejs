<%
  const tabs = [
    { label: 'All', value: '', count: counts.all },
    { label: 'Paid', value: 'Paid', count: counts.paid },
    { label: 'Pay on delivery', value: 'Pay on delivery', count: counts.cod },
  ];
%>
<div class="d-flex flex-wrap gap-2 mb-4">
  <% tabs.forEach(tab => { %>
    <a href="/admin/orders<%= tab.value ? '?status=' + encodeURIComponent(tab.value) : '' %>"
       class="<%= status === tab.value ? 'btn-admin' : 'btn-admin-outline' %>">
      <%= tab.label %> <span class="opacity-75">(<%= tab.count %>)</span>
    </a>
  <% }) %>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Order</th>
        <th>Customer</th>
        <th>Items</th>
        <th>Total</th>
        <th>Payment</th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length === 0) { %>
        <tr>
          <td colspan="5"><div class="admin-empty"><i class="fa-solid fa-receipt"></i>No orders found.</div></td>
        </tr>
      <% } %>
      <% orders.forEach(order => { %>
        <tr>
          <td class="text-nowrap">
            <div class="admin-item-name">#<%= order._id.toString().slice(-6).toUpperCase() %></div>
            <small class="admin-muted"><%= new Date(order.createdAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
          </td>
          <td style="min-width: 220px">
            <div class="admin-item-name"><%= order.name %></div>
            <small class="admin-muted d-block"><i class="fa-solid fa-phone me-1"></i><%= order.phone %></small>
            <small class="admin-muted d-block"><i class="fa-solid fa-location-dot me-1"></i><%= order.address %></small>
          </td>
          <td style="min-width: 240px">
            <% order.products.forEach(product => { %>
              <div class="d-flex align-items-center gap-2 mb-1">
                <% if (product.productId) { %>
                  <img class="admin-thumb" style="width:36px;height:36px" src="<%= product.productId.image %>" alt="">
                  <span><%= product.productId.name %> <span class="admin-muted">&times; <%= product.quantity %></span></span>
                <% } else { %>
                  <span class="admin-muted">Deleted product &times; <%= product.quantity %></span>
                <% } %>
              </div>
            <% }) %>
          </td>
          <td class="fw-semibold text-nowrap">Rs.<%= order.totalPrice %></td>
          <td class="text-nowrap">
            <span class="admin-badge <%= order.paymentStatus === 'Paid' ? 'success' : 'warning' %>"><%= order.paymentStatus || 'Pay on delivery' %></span>
            <small class="admin-muted d-block mt-1"><%= order.paymentDetails || 'Cash on delivery' %></small>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
