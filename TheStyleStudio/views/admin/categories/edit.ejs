<a href="/admin/categories" class="admin-muted d-inline-block mb-3"><i class="fa-solid fa-arrow-left me-1"></i> Back to categories</a>

<div class="row g-4">
  <div class="col-lg-7">
    <form action="/admin/categories/edit/<%= category._id %>" method="POST" class="admin-card">
      <div class="mb-3">
        <label for="categoryName" class="form-label">Category Name</label>
        <input type="text" class="form-control" id="categoryName" name="name" value="<%= category.name %>" required>
      </div>

      <div class="mb-4">
        <label for="categoryDescription" class="form-label">Description</label>
        <textarea class="form-control" id="categoryDescription" name="description" rows="4" required><%= category.description %></textarea>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn-admin"><i class="fa-solid fa-check"></i>Save Changes</button>
        <a href="/admin/categories" class="btn-admin-outline">Cancel</a>
      </div>
    </form>
  </div>

  <div class="col-lg-5">
    <div class="admin-card">
      <div class="admin-card-header">
        <h2 class="admin-card-title">Products in this category</h2>
        <span class="admin-badge"><%= products.length %></span>
      </div>
      <% if (products.length === 0) { %>
        <div class="admin-empty"><i class="fa-solid fa-shirt"></i>No products yet.</div>
      <% } %>
      <% products.forEach(product => { %>
        <div class="admin-list-item">
          <img class="admin-thumb" src="<%= product.image %>" alt="<%= product.name %>">
          <div class="flex-grow-1">
            <div class="admin-item-name"><%= product.name %></div>
            <small class="admin-muted">Rs.<%= product.price %></small>
          </div>
          <a href="/admin/products/edit/<%= product._id %>" class="btn-icon" title="Edit product" aria-label="Edit <%= product.name %>"><i class="fa-solid fa-pen"></i></a>
        </div>
      <% }) %>
    </div>
  </div>
</div>
