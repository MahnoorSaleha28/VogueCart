<a href="/admin/categories" class="admin-muted d-inline-block mb-3"><i class="fa-solid fa-arrow-left me-1"></i> Back to categories</a>

<div class="row">
  <div class="col-lg-8">
    <form action="/admin/categories/create" method="POST" class="admin-card">
      <div class="mb-3">
        <label for="categoryName" class="form-label">Category Name</label>
        <input type="text" class="form-control" id="categoryName" name="name" placeholder="e.g. Shoes" required>
      </div>

      <div class="mb-4">
        <label for="categoryDescription" class="form-label">Description</label>
        <textarea class="form-control" id="categoryDescription" name="description" rows="4" placeholder="What shoppers will find in this category" required></textarea>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn-admin"><i class="fa-solid fa-check"></i>Add Category</button>
        <a href="/admin/categories" class="btn-admin-outline">Cancel</a>
      </div>
    </form>
  </div>
</div>
