<p class="admin-muted"><%= summaries.length %> registered users &middot; orders are matched to users by the name entered at checkout</p>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>User</th>
        <th>Role</th>
        <th>Orders</th>
        <th>Total Spent</th>
        <th>Last Order</th>
      </tr>
    </thead>
    <tbody>
      <% if (summaries.length === 0) { %>
        <tr>
          <td colspan="5"><div class="admin-empty"><i class="fa-solid fa-users"></i>No users found.</div></td>
        </tr>
      <% } %>
      <% summaries.forEach(({ user, orderCount, totalSpent, lastOrder }) => { %>
        <tr>
          <td>
            <div class="d-flex align-items-center gap-3">
              <span class="admin-avatar"><%= (user.name || '?').charAt(0) %></span>
              <div>
                <div class="admin-item-name"><%= user.name || 'N/A' %></div>
                <small class="admin-muted"><%= user.email || 'N/A' %></small>
              </div>
            </div>
          </td>
          <td>
            <% (user.role && user.role.length ? user.role : ['user']).forEach(role => { %>
              <span class="admin-badge <%= role === 'admin' ? 'success' : '' %> text-capitalize"><%= role %></span>
            <% }) %>
          </td>
          <td><%= orderCount %></td>
          <td class="fw-semibold text-nowrap"><%= orderCount ? 'Rs.' + totalSpent : '—' %></td>
          <td class="text-nowrap admin-muted">
            <%= lastOrder ? new Date(lastOrder).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'No orders' %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
