<p class="admin-muted mb-4">Welcome back. Here's what's happening in your store.</p>

<!-- Stats -->
<div class="row g-3 mb-4">
  <%
    const statCards = [
      { label: 'Revenue', value: 'Rs.' + stats.revenue.toLocaleString('en-PK'), icon: 'fa-sack-dollar', href: '/admin/orders' },
      { label: 'Orders', value: stats.orderCount, icon: 'fa-receipt', href: '/admin/orders' },
      { label: 'Products', value: stats.productCount, icon: 'fa-shirt', href: '/admin/products' },
      { label: 'Categories', value: stats.categoryCount, icon: 'fa-layer-group', href: '/admin/categories' },
      { label: 'Users', value: stats.userCount, icon: 'fa-users', href: '/admin/user' },
    ];
  %>
  <% statCards.forEach((card, index) => { %>
    <%# Revenue is the longest number, so it gets the full width on phones %>
    <div class="<%= index === 0 ? 'col-12' : 'col-6' %> col-md-4 col-xl">
      <a class="stat-link" href="<%= card.href %>">
        <div class="admin-card stat-card">
          <span class="stat-icon"><i class="fa-solid <%= card.icon %>"></i></span>
          <div>
            <div class="stat-label"><%= card.label %></div>
            <div class="stat-value"><%= card.value %></div>
          </div>
        </div>
      </a>
    </div>
  <% }) %>
</div>

<div class="row g-4">
  <!-- Recent orders -->
  <div class="col-xl-7">
    <div class="admin-card h-100">
      <div class="admin-card-header">
        <h2 class="admin-card-title">Recent Orders</h2>
        <a href="/admin/orders" class="btn-admin-outline">View all</a>
      </div>
      <% if (recentOrders.length === 0) { %>
        <div class="admin-empty"><i class="fa-solid fa-receipt"></i>No orders yet.</div>
      <% } else { %>
        <% recentOrders.forEach(order => { %>
          <div class="admin-list-item">
            <span class="admin-avatar"><%= order.name.charAt(0) %></span>
            <div class="flex-grow-1">
              <div class="admin-item-name"><%= order.name %></div>
              <small class="admin-muted">#<%= order._id.toString().slice(-6).toUpperCase() %> &middot; <%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></small>
            </div>
            <span class="admin-badge <%= order.paymentStatus === 'Paid' ? 'success' : 'warning' %> d-none d-sm-inline-block"><%= order.paymentStatus || 'Pay on delivery' %></span>
            <strong class="ms-2">Rs.<%= order.totalPrice %></strong>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Best sellers -->
  <div class="col-xl-5">
    <div class="admin-card h-100">
      <div class="admin-card-header">
        <h2 class="admin-card-title">Best Sellers</h2>
        <a href="/admin/products" class="btn-admin-outline">Products</a>
      </div>
      <% if (topProducts.length === 0) { %>
        <div class="admin-empty"><i class="fa-solid fa-chart-simple"></i>No sales yet.</div>
      <% } else { %>
        <% topProducts.forEach(item => { %>
          <div class="admin-list-item">
            <img class="admin-thumb" src="<%= item.product.image %>" alt="<%= item.product.name %>">
            <div class="flex-grow-1">
              <div class="admin-item-name"><%= item.product.name %></div>
              <small class="admin-muted">Rs.<%= item.product.price %></small>
            </div>
            <span class="admin-badge"><%= item.sold %> sold</span>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>
