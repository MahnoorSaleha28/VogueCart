<%# Shared add/edit product form. Expects: action, product (or null), categories, submitLabel %>
<form action="<%= action %>" method="POST" enctype="multipart/form-data">
  <div class="row g-4">
    <!-- Image -->
    <div class="col-lg-4">
      <div class="admin-card">
        <label class="form-label" for="productImage">Product Image</label>
        <label class="image-drop" for="productImage" id="image-drop">
          <% if (product && product.image) { %>
            <img src="<%= product.image %>" alt="<%= product.name %>" id="image-preview">
          <% } else { %>
            <i class="fa-regular fa-image"></i>
            <span>Click to choose an image</span>
          <% } %>
        </label>
        <input type="file" class="d-none" id="productImage" name="productImage" accept="image/*" <%= product ? '' : 'required' %>>
        <small class="admin-muted d-block mt-2"><%= product ? 'Choose a new image to replace the current one.' : 'JPG, PNG or WebP. A square image looks best.' %></small>
      </div>
    </div>

    <!-- Details -->
    <div class="col-lg-8">
      <div class="admin-card">
        <div class="mb-3">
          <label for="productName" class="form-label">Product Name</label>
          <input type="text" class="form-control" id="productName" name="name" placeholder="e.g. Pastel Daisy Backpack" value="<%= product ? product.name : '' %>" required>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="productPrice" class="form-label">Price</label>
            <div class="input-group">
              <span class="input-group-text">Rs.</span>
              <input type="number" class="form-control" id="productPrice" name="price" min="0" step="1" placeholder="0" value="<%= product ? product.price : '' %>" required>
            </div>
          </div>
          <div class="col-md-6">
            <label for="category" class="form-label">Category</label>
            <select name="category" id="category" class="form-select" required>
              <option value="" disabled <%= product && product.category ? '' : 'selected' %>>Choose a category</option>
              <% categories.forEach(category => { %>
                <option value="<%= category._id %>" <%= product && product.category && category._id.toString() === product.category._id.toString() ? 'selected' : '' %>>
                  <%= category.name %>
                </option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="mb-4">
          <label for="productDescription" class="form-label">Description</label>
          <textarea class="form-control" id="productDescription" name="description" rows="5" placeholder="Describe the product for shoppers"><%= product ? product.description : '' %></textarea>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button type="submit" class="btn-admin"><i class="fa-solid fa-check"></i><%= submitLabel %></button>
          <a href="/admin/products" class="btn-admin-outline">Cancel</a>
        </div>
      </div>
    </div>
  </div>
</form>

<script>
  // Preview the chosen image before saving
  document.getElementById('productImage').addEventListener('change', function () {
    const file = this.files[0];
    if (!file) return;
    const drop = document.getElementById('image-drop');
    drop.innerHTML = '';
    const img = document.createElement('img');
    img.src = URL.createObjectURL(file);
    img.alt = 'Preview';
    drop.appendChild(img);
  });
</script>
